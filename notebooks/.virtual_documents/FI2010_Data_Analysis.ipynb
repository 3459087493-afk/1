def get_info(filename):
    # find the index of the breaks between tickers (b)
    d = np.loadtxt(filename)
    i = np.arange(d.shape[1])
    b = i[np.r_[[True], np.abs(np.diff(d[0])) > 0.01]]
    b = np.append(b, d.shape[1])
    return b, d


